# --- Foodoscope (required for live data) ---
# Get a key at https://www.foodoscope.com  (Starter plan = 200 free tokens, 25 req/min)
FOODOSCOPE_API_KEY=your_foodoscope_key_here
FOODOSCOPE_RECIPEDB_BASE=https://api.foodoscope.com
FOODOSCOPE_FLAVORDB_BASE=https://api.foodoscope.com/flavordb
# Protect the free token budget: results are cached on disk for 24h
FOODOSCOPE_CACHE_TTL=86400
FOODOSCOPE_MAX_CALLS=150

# --- Vision (either one; without these the app runs in demo-pantry mode) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
VISION_MODEL=gemini-3.6-flash
